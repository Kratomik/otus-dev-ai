# EcoTrack health server (backend/health)
# Defaults match Supabase self-hosted Postgres (container: supabase-db)

NODE_ENV=development
LOG_LEVEL=info

DB_HOST=supabase-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-super-secret-and-long-postgres-password
DB_NAME=postgres

# POST при degraded (GET /health). Пример: https://webhook.site/your-uuid
HEALTH_WEBHOOK_URL=

# CORS: * (dev) или список через запятую (prod)
CORS_ORIGINS=*

# Rate limit (окно в мс, лимиты на IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_LOGS_MAX=30
RATE_LIMIT_RECOMMENDATIONS_MAX=60

# In-memory кэш GET /recommendations (мс, по умолчанию 5 мин)
RECOMMENDATIONS_CACHE_TTL_MS=300000
