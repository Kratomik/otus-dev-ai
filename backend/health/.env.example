# EcoTrack health server (backend/health)
# Defaults match Supabase self-hosted Postgres (container: supabase-db)

DB_HOST=supabase-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-super-secret-and-long-postgres-password
DB_NAME=postgres

# POST при degraded (GET /health). Пример: https://webhook.site/your-uuid
HEALTH_WEBHOOK_URL=
