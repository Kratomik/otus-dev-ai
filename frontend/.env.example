# Copy to .env.local (ignored by git) and adjust for your Supabase stack.
# Vite reads .env.local automatically in dev.
# After changing any VITE_* variable, restart the dev server: npm run dev

VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=

# Yandex Metrika counter ID (optional in local dev without analytics)
VITE_YANDEX_METRIKA_ID=109250000

# Client logs (prod: warn/error → POST). Default in dev: http://localhost:3002/logs
# VITE_LOGS_API_URL=http://localhost:3002/logs